
@{
    ViewBag.Title = "BT4";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>TO-DO LIST</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f1f1f1;
        }

        .todo-container {
            width: 350px;
            margin:50px auto;
            background-color: white;
        }

        /* Ô nhập + nút + */
        .input-area {
            display: flex;
        }

        #txtTask {
            flex: 1;
            padding: 18px;
            font-size: 20px;
            border: none;
            background-color: #2f4054;
            color: white;
            outline: none;
        }

            #txtTask::placeholder {
                color: #aaa;
            }

        #btnAdd {
            width: 70px;
            font-size: 30px;
            font-weight: bold;
            border: none;
            background-color: #16cdb2;
            color: white;
            cursor: pointer;
        }

            #btnAdd:hover {
                background-color: #13b69f;
            }

        /* Danh sách */
        ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        li {
            display: flex;
            align-items: center;
            min-height: 60px;
            border-bottom: 1px solid #ddd;
            padding: 0 15px;
            font-size: 20px;
        }

            li input[type="checkbox"] {
                width: 18px;
                height: 18px;
                margin-right: 15px;
                cursor: pointer;
            }

        .task-text {
            flex: 1;
        }

        /* Công việc hoàn thành */
        li.completed .task-text {
            text-decoration: line-through;
            color: #bbb;
        }

        .btn-delete {
            border: none;
            background: none;
            color: red;
            font-size: 20px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <div class="todo-container">

        <div class="input-area">
            <input type="text"
                   id="txtTask"
                   placeholder="Enter a task">

            <button id="btnAdd">+</button>
        </div>

        <ul id="todoList">
            <li>
                <input type="checkbox">
                <span class="task-text">Việc 1</span>
                <button class="btn-delete">×</button>
            </li>

            <li>
                <input type="checkbox">
                <span class="task-text">Việc 2</span>
                <button class="btn-delete">×</button>
            </li>

            <li>
                <input type="checkbox">
                <span class="task-text">Việc 3</span>
                <button class="btn-delete">×</button>
            </li>
        </ul>

    </div>

    <script src="~/Scripts/BT4/BT4.js"></script>

</body>
</html>

