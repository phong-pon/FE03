
@{
    ViewBag.Title = "VD3";
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD3</title>
        <script language="javaScript">
            function Homnay() {
                var d = new Date();
                var month = d.getMonth() + 1;
                var year = d.getFullYear();
                alert("Hôm nay là ngày " + d.getDate() + " tháng " + month + " năm " + year);
            }
        </script>
</head>
<body>
    <form name="forml">
        <input type="button" value="hôm nay" onclick="Homnay();"/>
    </form>
</body>
</html>
